{
  "expo": {
    "name": "SpendLens",
    "slug": "spendlens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "appleTeamId": "JKD484739B",
      "supportsTablet": true,
      "bundleIdentifier": "app.spendlens.mobile",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "en"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.spendlens.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "spendlens",
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "SpendLens needs access to selected receipt photos.",
          "cameraPermission": "SpendLens uses the camera to photograph your receipts.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "de",
              "en"
            ],
            "android": [
              "de",
              "en"
            ]
          }
        }
      ]
    ],
    "locales": {
      "de": "./locales/de.json",
      "en": "./locales/en.json"
    }
  }
}
