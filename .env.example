# Local browser + ChatGPT subscription (eligible account required).
AUTH_MODE=local-plan
PORT=3001
SERVER_URL=http://127.0.0.1:3001
HOST=127.0.0.1
EXPO_PUBLIC_API_URL=http://127.0.0.1:3001
APP_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
APP_REDIRECT_URIS=http://localhost:8081/auth-return,http://127.0.0.1:8081/auth-return,spendlens://auth-return
# Optional in local-plan mode: an image-capable slug from the account's model catalog.
# OPENAI_MODEL=

# Native/hosted integration requires a provisioned OpenAI OAuth client.
# AUTH_MODE=registered
# SERVER_URL=https://api.example.com
# EXPO_PUBLIC_API_URL=https://api.example.com
# OPENAI_CLIENT_ID=oaiapp_...
# OPENAI_TOKEN_AUTH_METHOD=none
# Confidential clients only: client_secret_basic or client_secret_post
# OPENAI_CLIENT_SECRET=
# Identity login does not grant subscription inference. Registered mode uses server API billing.
# OPENAI_API_KEY=
# OPENAI_MODEL=<image-capable API model>
