  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "node": "^24.22.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "node scripts/check-ios-toolchain.mjs && expo run:ios",
    "web": "expo start --web",
    "server": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "build:web": "expo export --platform web",
    "phone": "expo start --go --lan",
    "phone:tunnel": "expo start --go --tunnel",
    "native:start": "expo start --dev-client --tunnel",
    "test:native": "swift test --package-path modules/spendlens-openai"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
